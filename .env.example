# === Application ===
APP_NAME=HomeBase
APP_VERSION=0.1.0
# Keep DEBUG=false outside local dev — DEBUG=true turns on SQL echo
DEBUG=false
ENVIRONMENT=development

# === Database (PostgreSQL) ===
# Production: Supabase transaction pooler URL (port 6543) — see docs.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/homebase

# === Authentication ===
# Production MUST override these (config fails fast if they are the defaults)
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
# Comma-separated exact origins allowed to make credentialed requests
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://homebase-seven-lac.vercel.app

# === Frontend ===
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === File Storage ===
# Production: Supabase Storage. Set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# (service role — server-side ONLY, never NEXT_PUBLIC) and files go to the
# private "documents" bucket instead of the local ./uploads dir.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in (Supabase Auth): public anon key + URL for the browser
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Cron (Vercel Cron Jobs / seed) ===
CRON_SECRET=change-me-to-a-random-secret

# === Notes ===
# `vercel env pull` MASKS encrypted values (they come back empty) — set real
# values in the Vercel dashboard instead of copying pulled files around.
# ENVIRONMENT=production must be set in Vercel (enables the secret fail-fast
# check and secure auth cookies).
